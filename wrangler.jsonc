{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sikantin-unusa-frontend",
  "account_id": "9617cd6ea5663db05f393a64609ea6a4",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/r/*", "/foto/*"]
  }
}
