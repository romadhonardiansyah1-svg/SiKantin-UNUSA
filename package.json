{
  "name": "sikantin-unusa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check:foundation": "node scripts/check-foundation.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "build": "npm run check:foundation && npm test && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "playwright-core": "1.62.1",
    "wrangler": "4.168.0"
  }
}
