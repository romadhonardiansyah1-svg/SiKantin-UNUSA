{
  "name": "sikantin-unusa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:types": "tsc",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:operasional": "node tests/e2e/operasional.mjs",
    "build": "npm run check:foundation && npm run check:types && npm test && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "playwright-core": "1.62.1",
    "qrcode-generator": "2.0.4",
    "typescript": "5.9.3",
    "wrangler": "4.168.0"
  }
}
